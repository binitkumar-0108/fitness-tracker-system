# Example environment variables
# MySQL (existing)
DATABASE_URL=mysql://root:your_mysql_password_here@localhost:3306/healthflow

# Supabase / Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For convenience you can also set DATABASE_URL to the full Postgres connection string
# DATABASE_URL=postgres://postgres:password@db.supabase.co:5432/postgres

# Other env examples
# JWT_SECRET=supersecret
# OWNER_OPEN_ID=your_owner_openidVITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=fitness-tracker-demo
DATABASE_URL=mysql://root:your_mysql_password_here@localhost:3306/healthflow
JWT_SECRET=put_a_super_secret_key_here
OAUTH_SERVER_URL=http://localhost:3000
OWNER_OPEN_ID=demo_admin
